# Server-only. Add in Vercel Settings > Environment Variables, then redeploy.
EXA_API_KEY=
# Required for Chat and Voice (ElevenLabs). Plan does not require an access code.
HAL_ACCESS_CODE=


# Server-only ElevenLabs voice agent. Run npm run setup:voice after adding keys.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional: pin a tested ElevenLabs agent version
ELEVENLABS_AGENT_VERSION_ID=

# Evaluation only; not used by the live Hal app.
GEMINI_API_KEY=
GEMINI_JUDGE_MODEL=
